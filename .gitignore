.claude/settings.local.json
node_modules/
dist/

# World-space geometry dumps for the reference-free gates. Regenerate with
#   node tools/export_geometry.mjs --meshes renders/<pass>/meshes.json
# They are ~2 MB each and derive entirely from the committed factory, so the gate
# verdicts are kept in reviewHistory rather than the inputs that produced them.
renders/*/meshes.json
__pycache__/

# Extracted reference PBR maps are evidence, not assets: they are regenerable from
# reference/bench-vise.png with extract_pbr_evidence.py and each one is 1024px.
material-evidence/*_albedo.png
material-evidence/*_roughness.png
material-evidence/*_height.png
material-evidence/*_normal.png
material-evidence/*_ao.png
